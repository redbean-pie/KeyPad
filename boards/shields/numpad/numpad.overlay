/*
 * Copyright (c) 2026
 * SPDX-License-Identifier: MIT
 *
 * 数字小键盘 shield（nice!nano v2 / Pro Micro 互连）
 * 6x4 矩阵(含编码器按下虚拟行) + EC11 旋钮 + AI32C 触摸滑块
 *
 * 引脚分配（按排针物理位置连续）：
 *   左列 D2-D9：C0=D2 C1=D3 C2=D4 C3=D5 | AI32C: OUT1=D6 OUT2=D7 | EC11: A=D8 B=D9
 *   右列 D10-D19：R0=D10 R1=D16 R2=D14 R3=D15 R4=D18 R5=D19(编码器按下)
 *   预留：D0/D1（串口）、D20/D21
 */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan;
        zmk,physical-layout = <&numpad_layout>;
    };

    /* Composite kscan: matrix + AI32C touch */
    kscan: kscan {
        compatible = "zmk,kscan-composite";

        matrix {
            kscan = <&kscan_matrix>;
            row-offset = <0>;
            col-offset = <0>;
        };

        touch {
            kscan = <&kscan_ai32c>;
            row-offset = <6>;
            col-offset = <0>;
        };
    };

    /* 6x4 matrix kscan */
    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&pro_micro 2  GPIO_ACTIVE_HIGH>
            , <&pro_micro 3  GPIO_ACTIVE_HIGH>
            , <&pro_micro 4  GPIO_ACTIVE_HIGH>
            , <&pro_micro 5  GPIO_ACTIVE_HIGH>
            ;
    };

    /* AI32C 3-channel capacitive touch slider */
    kscan_ai32c: kscan_ai32c {
        compatible = "zmk,kscan-gpio-ai32c";
        out-gpios
            = <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
        poll-period-ms = <10>;
    };

    /* Transform: 9 rows x 4 cols */
    /* R0-R4: matrix keys     R5: encoder press    R6-R8: touch slider */
    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <9>;
//  | Num | /   | *   | -      |   R0
//  | 7   | 8   | 9   | (2U+)  |   R1C3 空位(+轴在R2C3)
//  | 4   | 5   | 6   | +      |   R2
//  | 1   | 2   | 3   | (2UE)  |   R3C3 空位(Enter轴在R4C3)
//  |(0,2U宽)| . | Enter |     |   R4C0 空(0为2U宽,轴在R4C1)
//  | ENC | -   | -   | -      |   R5 = 编码器按下=切层
//  | T1  | -   | -   | -      |   R6 = 触摸滑块 KEY1
//  | T2  | -   | -   | -      |   R7 = 触摸滑块 KEY2
//  | T3  | -   | -   | -      |   R8 = 触摸滑块 KEY3
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3)
RC(1,0) RC(1,1) RC(1,2) RC(1,3)
RC(2,0) RC(2,1) RC(2,2) RC(2,3)
RC(3,0) RC(3,1) RC(3,2) RC(3,3)
RC(4,0) RC(4,1) RC(4,2) RC(4,3)
RC(5,0) RC(5,1) RC(5,2) RC(5,3)
RC(6,0) RC(6,1) RC(6,2) RC(6,3)
RC(7,0) RC(7,1) RC(7,2) RC(7,3)
RC(8,0) RC(8,1) RC(8,2) RC(8,3)
        >;
    };

    numpad_layout: numpad_layout {
        compatible = "zmk,physical-layout";
        display-name = "Numpad";
        transform = <&default_transform>;
    };

    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };
};

&encoder {
    status = "okay";
};
