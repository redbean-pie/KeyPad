 * SPDX-License-Identifier: MIT
 *
 * 数字小键盘 shield（nice!nano v2 / Pro Micro 互连）
 * 5x4 矩阵(编码器按压复用 R4C0 空位) + EC11 旋钮 + AI32C 触摸滑块
 *
 * 引脚分配（按排针物理位置连续）：
 *   左列 D2-D9：C0=D2 C1=D3 C2=D4 C3=D5 | AI32C: OUT1=D6 OUT2=D7 | EC11: A=D8 B=D9
 *   右列 D10-D18：R0=D10 R1=D16 R2=D14 R3=D15 R4=D18
 *   WS2812 主链: DATA=D20 (P0.29, SPIM3 MOSI) — 19 颗 RGB 效果
 *   WS2812 电量链: DATA=D19 (P0.2, SPIM2 MOSI) — 2 颗电量灯
 *   预留：D0/D1（串口）、D21
 *
 * 编码器按压：复用矩阵 R4C0（0 行空位，行 D18 + 列 D2），不再需要独立虚拟行
 */
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>

/ {
    chosen {
        zmk,kscan = &kscan;
        zmk,physical-layout = <&numpad_layout>;
        zmk,underglow = &led_strip;
    };

    /* Composite kscan: matrix + AI32C touch */
    kscan: kscan {
        compatible = "zmk,kscan-composite";

        matrix {
            kscan = <&kscan_matrix>;
            row-offset = <0>;
            col-offset = <0>;
        };

        touch {
            kscan = <&kscan_ai32c>;
            row-offset = <5>;
            col-offset = <0>;
        };
    };

    /* 5x4 matrix kscan (R4C0 = encoder press) */
    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&pro_micro 2  GPIO_ACTIVE_HIGH>
            , <&pro_micro 3  GPIO_ACTIVE_HIGH>
            , <&pro_micro 4  GPIO_ACTIVE_HIGH>
            , <&pro_micro 5  GPIO_ACTIVE_HIGH>
            ;
    };

    /* AI32C 3-channel capacitive touch slider */
    kscan_ai32c: kscan_ai32c {
        compatible = "zmk,kscan-gpio-ai32c";
        wakeup-source;
        out-gpios
            = <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
        poll-period-ms = <10>;
    };

    /* Transform: 8 rows x 4 cols */
    /* R0-R4: matrix keys (R4C0 = encoder press)    R5-R7: touch slider */
    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <8>;
//  | Num | /   | *   | -      |   R0
//  | 7   | 8   | 9   | (2U+)  |   R1C3 空位(+轴在R2C3)
//  | 4   | 5   | 6   | +      |   R2
//  | 1   | 2   | 3   | (2UE)  |   R3C3 空位(Enter轴在R4C3)
//  |ENC |  0  |  .  | Enter  |   R4C0 编码器按压(0为2U宽,轴在R4C1)
//  | T1  | -   | -   | -      |   R5 = 触摸滑块 KEY1
//  | T2  | -   | -   | -      |   R6 = 触摸滑块 KEY2
//  | T3  | -   | -   | -      |   R7 = 触摸滑块 KEY3
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3)
RC(1,0) RC(1,1) RC(1,2) RC(1,3)
RC(2,0) RC(2,1) RC(2,2) RC(2,3)
RC(3,0) RC(3,1) RC(3,2) RC(3,3)
RC(4,0) RC(4,1) RC(4,2) RC(4,3)
RC(5,0) RC(5,1) RC(5,2) RC(5,3)
RC(6,0) RC(6,1) RC(6,2) RC(6,3)
RC(7,0) RC(7,1) RC(7,2) RC(7,3)
        >;
    };

    numpad_layout: numpad_layout {
        compatible = "zmk,physical-layout";
        display-name = "Numpad";
        transform = <&default_transform>;
    };

    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };
};

&encoder {
    status = "okay";
};

/* WS2812 RGB 灯珠：SPIM3 MOSI = D20 (P0.29)，每键 1 颗共 19 颗 */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 29)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 29)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <19>; /* 每键 1 颗，共 19 颗 */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

/* WS2812 电量指示灯：SPIM2 MOSI = D19 (P0.2)，2 颗，独立链避免与 RGB 冲突 */
&pinctrl {
    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 2)>;
        };
    };

    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 2)>;
            low-power-enable;
        };
    };
};

&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip_batt: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <2>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};
