 * SPDX-License-Identifier: MIT
 *
 * 布局（6行4列，R5为编码器按下虚拟行）：
 *  | Num | /   | *   | -     |
 *  | 7   | 8   | 9   | (2U+) |   R1C3 空位
 *  | 4   | 5   | 6   | +     |
 *  | 1   | 2   | 3   | (2UE) |   R3C3 空位
 *  | FN  | 0   | .   | Enter |
 *  | ENC | -   | -   | -     |   R5C0 编码器按下(D10)
 *
 * FN 单键切换编码器模式：层0=音量 / 层1=亮度
 * 组合键进 bootloader/reset（参考 murphpad）
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define TIMEOUT 300

&encoder {
    status = "okay";
};

/ {
    combos {
        compatible = "zmk,combos";
        // NumLock(0) + -(3) → bootloader
        combo_bootloader {
            timeout-ms = <TIMEOUT>;
            key-positions = <0 3>;
            bindings = <&bootloader>;
        };
        // NumLock(0) + *(2) → 系统重启
        combo_reset {
            timeout-ms = <TIMEOUT>;
            key-positions = <0 2>;
            bindings = <&sys_reset>;
        };
    };

    keymap: keymap {
        compatible = "zmk,keymap";

        // 默认层：编码器 = 音量 ±，按下 = 静音
        default_layer {
            display-name = "Numpad";
            bindings = <
&kp KP_NUM     &kp KP_DIVIDE   &kp KP_MULTIPLY   &kp KP_MINUS
&kp KP_N7      &kp KP_N8       &kp KP_N9         &none
&kp KP_N4      &kp KP_N5       &kp KP_N6         &kp KP_PLUS
&kp KP_N1      &kp KP_N2       &kp KP_N3         &none
&to 1          &kp KP_N0       &kp KP_DOT        &kp KP_ENTER
&kp C_MUTE     &none           &none             &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // 亮度层：编码器 = 亮度 ±，按下 = 静音
        fn_layer {
            display-name = "Bright";
            bindings = <
&trans         &trans          &trans            &trans
&trans         &trans          &trans            &none
&trans         &trans          &trans            &trans
&trans         &trans          &trans            &none
&to 0          &trans          &trans            &trans
&trans         &none           &none             &none
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };
    };
};
