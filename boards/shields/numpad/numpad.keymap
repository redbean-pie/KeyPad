#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap: keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Numpad";
//  | ENC    | Num   | /     | *        |
//  | -      | 7     | 8     | 9        |
//  | +      | 4     | 5     | 6        |
//  | Enter  | 1     | 2     | 3        |
//  | FN     | 0     | .     | —        |
            bindings = <
&kp C_MUTE   &kp KP_NUM     &kp KP_DIVIDE   &kp KP_MULTIPLY
&kp KP_MINUS &kp KP_N7      &kp KP_N8       &kp KP_N9
&kp KP_PLUS  &kp KP_N4      &kp KP_N5       &kp KP_N6
&kp KP_ENTER &kp KP_N1      &kp KP_N2       &kp KP_N3
&mo 1        &kp KP_N0      &kp KP_DOT      &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_layer {
            display-name = "Fn";
//  | —      | OutTog | BT_PRV | BT_NXT |
//  | —      | —      | —      | —      |
//  | —      | —      | —      | —      |
//  | —      | —      | —      | —      |
//  | —      | BT_CLR | Reset  | Boot   |
            bindings = <
&trans       &out OUT_TOG   &bt BT_PRV      &bt BT_NXT
&trans       &trans         &trans          &trans
&trans       &trans         &trans          &trans
&trans       &trans         &trans          &trans
&trans       &bt BT_CLR     &sys_reset      &bootloader
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};
